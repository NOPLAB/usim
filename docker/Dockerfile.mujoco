# Standalone MuJoCo CPU / Warp CUDA runtime. Build from the repository root.
FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_HTTP_TIMEOUT=300 \
    UV_CONCURRENT_DOWNLOADS=2 \
    UV_CONCURRENT_INSTALLS=1 \
    UV_CONCURRENT_BUILDS=1 \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    USIM_ROOT=/workspace/usim \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

RUN apt-get update && apt-get install -y --no-install-recommends libegl1 libgl1 \
    && rm -rf /var/lib/apt/lists/* \
    && uv venv --python /usr/local/bin/python3.12 /opt/venv

WORKDIR /workspace/usim
COPY pyproject.toml LICENSE /workspace/usim/
COPY src /workspace/usim/src
COPY packages /workspace/usim/packages
COPY examples/worlds /workspace/usim/worlds

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python \
        /workspace/usim "/workspace/usim/packages/mujoco[warp]" \
    && uv pip check --python /opt/venv/bin/python \
    && python -m usim.cli --help

ENTRYPOINT ["python", "-m", "usim.cli"]
CMD ["--help"]
